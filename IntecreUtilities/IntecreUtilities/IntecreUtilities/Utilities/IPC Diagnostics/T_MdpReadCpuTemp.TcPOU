<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="T_MdpReadCpuTemp" Id="{e0065e76-d33a-4e1b-a8bc-52fca8279681}" SpecialFunc="None">
    <Declaration><![CDATA[/// cyclically reads the cpu temp at the update period (default 500 ms) through Tc3_IPCDiag.
{attribute 'contains_implicit_enum'}
FUNCTION_BLOCK T_MdpReadCpuTemp
VAR
   updateTimer : TON := (PT := TIME#500ms);
   /// finds the IPC diagnostic modules once; read by readCpuTemp
   diagRegister : FB_IPCDiag_Register;
   readCpuTemp : FB_IPCDiag_ReadParameter;
   registered : BOOL;
   _cpuTemp : INT;
   _error : BOOL;
   _errorId : UDINT;
   {attribute 'implicit_enum_type' := ''}
   state : (
      mrctInit := 0, // waiting for the update timer
      mrctRegister,
      mrctWaitForRegister,
      mrctReadCpuTemp,
      mrctWaitForReadComplete
   );
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE state OF

   mrctInit:

      IF updateTimer.Q THEN
         state := SEL(registered, mrctRegister, mrctReadCpuTemp);
      END_IF

   mrctRegister:

      state := mrctWaitForRegister;

   mrctWaitForRegister:

      IF NOT diagRegister.bBusy THEN

         registered := NOT diagRegister.bError;
         _error := diagRegister.bError;
         _errorId := SEL(diagRegister.bError, 0, TO_UDINT(diagRegister.hrErrorCode));
         state := SEL(registered, mrctInit, mrctReadCpuTemp);

      END_IF

   mrctReadCpuTemp:

      state := mrctWaitForReadComplete;

   mrctWaitForReadComplete:

      IF NOT readCpuTemp.bBusy THEN

         IF readCpuTemp.bError THEN
            _error := TRUE;
            _errorId := TO_UDINT(readCpuTemp.hrErrorCode);
         ELSE
            _errorId := TO_UDINT(readCpuTemp.GetParameter(pBuffer := ADR(_cpuTemp), nBufferSize := SIZEOF(_cpuTemp)));
            _error := _errorId <> 0;
         END_IF

         state := mrctInit;

      END_IF

ELSE

   state := mrctInit;

END_CASE

updateTimer(
   IN := state = mrctInit
);

diagRegister(
   bExecute := state = mrctRegister
);

readCpuTemp(
   bExecute := state = mrctReadCpuTemp,
   eParameterKey := E_IPCDiag_ParameterKey.CPU_Temp,
   fbRegister := diagRegister
);]]></ST>
    </Implementation>
    <Property Name="Busy" Id="{fdefc8c5-2d51-4f3f-b7dc-6050cfc8022e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'variable'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{1f2eec0b-628f-46de-b9c3-8e6ef8fa80e3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := state <> mrctInit;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CpuTemp" Id="{8825d759-f03d-458c-b53d-c4b34db13039}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY CpuTemp : INT
]]></Declaration>
      <Get Name="Get" Id="{849c0c14-513d-4cad-9600-70f382d07c9a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CpuTemp := THIS^._cpuTemp;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Error" Id="{b377bdf0-eee3-4f8a-8532-1a443c8d6e90}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'variable'}
PROPERTY Error : BOOL
]]></Declaration>
      <Get Name="Get" Id="{146efe53-e3fc-4f51-aa4d-8a47191b0902}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := NOT Busy AND _error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ErrorId" Id="{71f8c472-e21b-4090-a549-ebb9bfb87bc1}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'variable'}
PROPERTY ErrorId : UDINT
]]></Declaration>
      <Get Name="Get" Id="{416a38a4-c638-4f00-a26b-9c06c0826534}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorId := SEL(Busy, _errorId, 0);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetUpdateTimerValue" Id="{ec3d15a0-c102-46bf-a9be-641e6336c5c8}">
      <Declaration><![CDATA[METHOD SetUpdateTimerValue
VAR_INPUT
   UpdatePeriod : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF UpdatePeriod > T#1MS THEN
   THIS^.updateTimer.PT := UpdatePeriod;
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>