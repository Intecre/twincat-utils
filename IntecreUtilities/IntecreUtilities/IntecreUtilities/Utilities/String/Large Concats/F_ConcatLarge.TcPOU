<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_ConcatLarge" Id="{4db9989f-1492-47e5-8436-5fadffe0d25b}" SpecialFunc="None">
    <Declaration><![CDATA[// Concatenates two LongStrings. The result is cut at StringsParams.MAX_STRING_LENGTH - 1 characters,
// keeping StringTwo whole and truncating StringOne. Lengths are measured with LEN2 because the
// Tc2_Standard string functions stop at 255 characters.
FUNCTION F_ConcatLarge : LongString
VAR_IN_OUT CONSTANT
   StringOne : LongString;
   StringTwo : LongString;
END_VAR
VAR
   lenOne, lenTwo, sizeToCpy, teminatingCharPos, maxLen : DINT;
   response : LongString;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[maxLen := TO_DINT(StringsParams.MAX_STRING_LENGTH) - 1; // - 1 allows for terminating character in last position.
lenOne := TO_DINT(LEN2(ADR(StringOne)));
lenTwo := TO_DINT(LEN2(ADR(StringTwo)));

IF lenOne + lenTwo > maxLen THEN
   sizeToCpy := MAX(maxLen - lenTwo, 0); // need room for the terminating character
   teminatingCharPos := maxLen; // this is the index position for utf-8 string as byte array

ELSE
   sizeToCpy := lenOne;
   teminatingCharPos := lenOne + lenTwo;

END_IF

// copy strings into response
MEMCPY(ADR(response), ADR(StringOne), TO_UDINT(sizeToCpy));
MEMCPY(ADR(response[sizeToCpy]), ADR(StringTwo), TO_UDINT(MIN(lenTwo, maxLen - sizeToCpy)));

response[teminatingCharPos] := 16#0; // string terminating character
F_ConcatLarge := response;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>