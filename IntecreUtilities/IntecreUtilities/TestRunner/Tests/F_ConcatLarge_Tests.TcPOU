    </Method>
    <Method Name="Test_Concat7Large" Id="{0b460051-58d9-46ae-b5f1-46634f592019}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Concat7Large
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());

one := 'a'; two := 'b'; three := 'c'; four := 'd'; five := 'e'; six := 'f'; seven := 'g';
result := F_Concat7_Large(one, two, three, four, five, six, seven);
AssertTrue(Condition := result = 'abcdefg', Message := 'seven long strings joined');

TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_ConcatsTwoStrings" Id="{91a05143-8fb7-4d26-84df-56669c4b2c26}">
      <Declaration><![CDATA[METHOD PRIVATE Test_ConcatsTwoStrings
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());

// arrange
one := 'abc';
two := 'def';

// act
result := F_ConcatLarge(one, two);

// assert
AssertTrue(Condition := result = 'abcdef', Message := 'two long strings joined');
AssertEquals_INT(Expected := 6, Actual := LEN(result), Message := 'length of the join');

TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_TruncatesFirstStringToFitMaxLength" Id="{bc35825e-b38d-495a-8111-afeac450d40b}">
      <Declaration><![CDATA[METHOD PRIVATE Test_TruncatesFirstStringToFitMaxLength
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());

// arrange: 150 + 150 characters exceed the 299 usable characters of a LongString
one := Fill(150, 97); // 'a'
two := Fill(150, 98); // 'b'

// act
result := F_ConcatLarge(one, two);

// assert (LEN stops at 255 characters, LEN2 measures the whole string)
AssertEquals_UDINT(Expected := 299, Actual := LEN2(ADR(result)), Message := 'result fills the LongString');
AssertEquals_BYTE(Expected := 97, Actual := result[148], Message := 'first string keeps 149 characters');
AssertEquals_BYTE(Expected := 98, Actual := result[149], Message := 'second string starts where the first was cut');
AssertEquals_BYTE(Expected := 98, Actual := result[298], Message := 'second string kept whole');
AssertEquals_BYTE(Expected := 0, Actual := result[299], Message := 'terminator in the last position');

// arrange: a second string longer than 255 characters must be measured in full
one := Fill(10, 97);
two := Fill(280, 98);

// act
result := F_ConcatLarge(one, two);

// assert
AssertEquals_UDINT(Expected := 290, Actual := LEN2(ADR(result)), Message := 'inputs over 255 characters are measured in full');
AssertEquals_BYTE(Expected := 97, Actual := result[9], Message := 'first string copied whole');
AssertEquals_BYTE(Expected := 98, Actual := result[289], Message := 'last character of the second string kept');
AssertEquals_BYTE(Expected := 0, Actual := result[290], Message := 'terminator after the join');

TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>