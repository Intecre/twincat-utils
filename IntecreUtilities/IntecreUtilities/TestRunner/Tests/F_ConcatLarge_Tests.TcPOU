<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="F_ConcatLarge_Tests" Id="{a2be9199-3b70-4b40-9774-afea6658d415}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK F_ConcatLarge_Tests EXTENDS TcUnit.FB_TestSuite
VAR
  one, two, three, four, five, six, seven : LongString;
  result : LongString;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_ConcatsTwoStrings();
Test_TruncatesFirstStringToFitMaxLength();
Test_Concat3Large();
Test_Concat4Large();
Test_Concat5Large();
Test_Concat6Large();
Test_Concat7Large();
Test_ClearLargeEmptiesString();
]]></ST>
    </Implementation>
    <Method Name="Fill" Id="{b98fb265-30c6-40b4-ae6c-24811c945fca}">
      <Declaration><![CDATA[// Test helper: a LongString of count copies of the byte ch.
METHOD PRIVATE Fill : LongString
VAR_INPUT
  count : INT;
  ch : BYTE;
END_VAR
VAR
  i : INT;
  text : LongString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO count - 1 DO
  text[i] := ch;
END_FOR
text[count] := 0;
Fill := text;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_ClearLargeEmptiesString" Id="{75406280-dbd3-474a-9f70-6ffadae13d2e}">
      <Declaration><![CDATA[METHOD PRIVATE Test_ClearLargeEmptiesString
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());

// arrange
one := 'abc';

// act
F_ClearLarge(one);

// assert
AssertEquals_INT(Expected := 0, Actual := LEN(one), Message := 'cleared string is empty');
AssertEquals_BYTE(Expected := 0, Actual := one[1], Message := 'bytes behind the terminator are zeroed too');

TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Concat3Large" Id="{f5c592dd-a912-412a-b958-2859c4d9d721}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Concat3Large
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());

one := 'a'; two := 'b'; three := 'c';
result := F_Concat3_Large(one, two, three);
AssertTrue(Condition := result = 'abc', Message := 'three long strings joined');

TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Concat4Large" Id="{77353f69-3adb-402a-9878-5ae92c129f62}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Concat4Large
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());

one := 'a'; two := 'b'; three := 'c'; four := 'd';
result := F_Concat4_Large(one, two, three, four);
AssertTrue(Condition := result = 'abcd', Message := 'four long strings joined');

TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
